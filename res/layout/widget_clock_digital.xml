<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Clock Digits Row: Hours : Minutes + Stacked Seconds & AM/PM (JetBrains Mono Bold) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal">

        <!-- Hours -->
        <TextView
            android:id="@+id/widget_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textColor="#ffffff"
            android:textSize="56sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_bold"
            android:typeface="monospace"
            android:includeFontPadding="false" />

        <!-- Themed Blinking Colon -->
        <TextView
            android:id="@+id/widget_colon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textColor="#00f0ff"
            android:textSize="52sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_bold"
            android:typeface="monospace"
            android:includeFontPadding="false"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp" />

        <!-- Minutes -->
        <TextView
            android:id="@+id/widget_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:textColor="#ffffff"
            android:textSize="56sp"
            android:textStyle="bold"
            android:fontFamily="@font/jetbrains_bold"
            android:typeface="monospace"
            android:includeFontPadding="false" />

        <!-- Seconds and AM/PM Badge Container -->
        <LinearLayout
            android:id="@+id/widget_sec_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="left|center_vertical"
            android:layout_marginLeft="6dp">

            <!-- Seconds in Theme Accent Color -->
            <TextView
                android:id="@+id/widget_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00"
                android:textColor="#00f0ff"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/jetbrains_bold"
                android:typeface="monospace"
                android:includeFontPadding="false" />

            <!-- AM/PM Badge matching app -->
            <ImageView
                android:id="@+id/widget_ampm"
                android:layout_width="38dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Smooth Live Seconds Progress Bar -->
    <ImageView
        android:id="@+id/widget_live_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:scaleType="fitXY"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Date Row (Sans-Serif uppercase with letter spacing) -->
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUNDAY, SEP 20, 2026"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:includeFontPadding="false"
        android:layout_gravity="center_horizontal" />

    <!-- Meta Tags: WEEK / DAY / LOCAL -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_meta_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_meta_pill"
            android:text="WEEK 38"
            android:textColor="#888888"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:includeFontPadding="false"
            android:layout_marginRight="4dp" />

        <TextView
            android:id="@+id/widget_meta_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_meta_pill"
            android:text="DAY 262"
            android:textColor="#888888"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:includeFontPadding="false"
            android:layout_marginRight="4dp" />

        <TextView
            android:id="@+id/widget_meta_tz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_meta_pill"
            android:text="LOCAL"
            android:textColor="#888888"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
